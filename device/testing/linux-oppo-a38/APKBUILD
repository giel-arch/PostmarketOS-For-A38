pkgname=linux-oppo-a38
pkgver=6.6.30
pkgrel=3
pkgdesc="OPPO A38 kernel (prebuilt from Kernel-mt6769-a38-PMOS)"
arch="aarch64"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
license="GPL-2.0-only"
url="https://github.com/giel-arch/Kernel-mt6769-a38-PMOS"
source="Image.gz"

build() {
	return 0
}

package() {
	_flavor="oppo-a38"
	_kver="$pkgver-$_flavor"

	install -Dm644 "$startdir/Image.gz" \
		"$pkgdir/boot/vmlinuz-$_flavor"

	# Kernel GKI ini tidak membangun modul dari tree (semua modul
	# platform MTK datang dari vendor_boot / mtk-vendor-modules),
	# tapi mkinitfs butuh struktur lib/modules yang valid.
	mkdir -p "$pkgdir/lib/modules/$_kver"
	touch "$pkgdir/lib/modules/$_kver/modules.order"
	touch "$pkgdir/lib/modules/$_kver/modules.builtin"
	touch "$pkgdir/lib/modules/$_kver/modules.builtin.modinfo"

	# mkinitfs membaca versi kernel dari sini
	mkdir -p "$pkgdir/usr/share/kernel/$_flavor"
	echo "$_kver" > "$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}
